<html lang="ko" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <link type="text/css" rel="stylesheet" href="./assets/css/launcher.css">
    <style>
        body {
            /*background: url('assets/images/backgrounds/<%=bkid%>.jpg') no-repeat center center fixed;*/
            transition: background-image 1s ease;
            background-image: url('data:image/jpeg;base64,');
            background-size: cover;
            -webkit-user-select: none;
            background-color: transparent;
            border-radius: 16px;
            overflow: hidden;
        }
        html {
            background: transparent;
            border-radius: 16px;
            overflow: hidden;
            clip-path: inset(0 round 16px);
        }
        html.window-maximized {
            border-radius: 0;
            clip-path: none;
        }
        body {
            width: 100%;
            height: 100%;
            box-shadow: 0 18px 48px rgba(3, 3, 13, 0.46);
            clip-path: inset(0 round 16px);
        }
        body.window-maximized {
            border-radius: 0;
            box-shadow: none;
            clip-path: none;
        }
        body.window-maximized #main {
            border-radius: 0;
            clip-path: none;
        }
        #main {
            display: none;
            height: calc(100% - 22px);
            background: linear-gradient(to top, rgba(0, 0, 0, 0.75) 0%, rgba(0, 0, 0, 0) 100%);
            width: 100%;
            position: absolute;
            z-index: 10;
            overflow: hidden;
            border-radius: 16px;
            clip-path: inset(0 round 16px);
        }
        #main[overlay] {
            filter: blur(3px) contrast(0.9) brightness(1.0);
        }
    </style>
</head>
<body bkid="<%=bkid%>">
    <%- include('frame') %>
    <div id="main">
        <%- include('welcome') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('landing') %>
    </div>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <div id="loadingContent">
            <div id="loadSpinnerContainer">
                <div id="nebulaLoadingStar" aria-hidden="true">
                    <span class="loadingMeteor loadingMeteorOne"></span>
                    <span class="loadingMeteor loadingMeteorTwo"></span>
                    <span class="loadingMeteor loadingMeteorThree"></span>
                    <span class="loadingMeteor loadingMeteorFour"></span>
                    <span class="loadingMeteor loadingMeteorFive"></span>
                    <span class="loadingMeteor loadingMeteorSix"></span>
                </div>
                <div id="loadSpinnerImage" class="rotating" aria-hidden="true"></div>
            </div>
        </div>
    </div>
    <script src="./assets/js/renderer-ready.js"></script>
</body>
</html>