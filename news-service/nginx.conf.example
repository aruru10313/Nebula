server {
    listen 80;
    server_name mc.aruru.kr;

    # Keep the existing HTTPS policy at the edge.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name mc.aruru.kr;

    # Keep the certificate paths managed by the existing Oracle setup.
    ssl_certificate /etc/letsencrypt/live/mc.aruru.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mc.aruru.kr/privkey.pem;

    root /var/www/mc.aruru.kr;
    index index.html;

    location = /aruru/admin {
        proxy_pass http://127.0.0.1:3001/aruru/admin;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /aruru/admin/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /auth/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /news-assets/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_hide_header Cross-Origin-Resource-Policy;
        add_header Cross-Origin-Resource-Policy "cross-origin" always;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
